                <mxCell id="708" value="&lt;ul style=&quot;box-sizing: border-box; padding-left: 2rem; margin-top: 0px; margin-bottom: 1rem; caret-color: rgb(33, 37, 41); color: rgb(33, 37, 41); font-family: system-ui, -apple-system, &amp;quot;Segoe UI&amp;quot;, Roboto, &amp;quot;Helvetica Neue&amp;quot;, &amp;quot;Noto Sans&amp;quot;, &amp;quot;Liberation Sans&amp;quot;, Arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 17px; text-align: start;&quot;&gt;&lt;li style=&quot;box-sizing: border-box;&quot;&gt;Chat‑Erhebung von Anlass/Tonalität/Empfänger:in/Bildstil.&lt;/li&gt;&lt;li style=&quot;box-sizing: border-box;&quot;&gt;Generierung&lt;span class=&quot;Apple-converted-space&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-weight: bolder;&quot;&gt;mehrsprachiger Textvorschläge&lt;/span&gt;&lt;span class=&quot;Apple-converted-space&quot;&gt;&amp;nbsp;&lt;/span&gt;(LLM) +&lt;span class=&quot;Apple-converted-space&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-weight: bolder;&quot;&gt;Layout‑Vorschau&lt;/span&gt;&lt;span class=&quot;Apple-converted-space&quot;&gt;&amp;nbsp;&lt;/span&gt;(Template‑Engine, Bildoption).&lt;/li&gt;&lt;li style=&quot;box-sizing: border-box;&quot;&gt;Personalisierung (Namen, Logos, Farben, Schriften), Upload eigener Medien.&lt;/li&gt;&lt;li style=&quot;box-sizing: border-box;&quot;&gt;Export&lt;span class=&quot;Apple-converted-space&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; font-weight: bolder;&quot;&gt;PNG/PDF&lt;/span&gt;&lt;span class=&quot;Apple-converted-space&quot;&gt;&amp;nbsp;&lt;/span&gt;(drucktauglich), Teilen‑Links; Batch‑Export für KMU.&lt;/li&gt;&lt;li style=&quot;box-sizing: border-box;&quot;&gt;Verwaltung: Vorlagenkatalog, gespeicherte Karten, CI‑Profile (B2B).&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
